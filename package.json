{
  "name": "typing-garden",
  "version": "1.0.0",
  "description": "A local typing practice app for kids.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:app": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "build:mac": "bash scripts/build-mac.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1"
  },
  "keywords": [
    "typing",
    "kids",
    "education"
  ],
  "author": "wanqingcn",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wanqingcn/typing-garden.git"
  },
  "homepage": "https://github.com/wanqingcn/typing-garden#readme",
  "bugs": {
    "url": "https://github.com/wanqingcn/typing-garden/issues"
  },
  "type": "module",
  "build": {
    "appId": "io.github.wanqingcn.typinggarden",
    "productName": "Typing Garden",
    "directories": {
      "output": "release"
    },
    "artifactName": "Typing-Garden-${version}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "assets/icons/typing-garden-icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
